{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/dvla/mot-history/sync",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/statistics/daily-briefing/generate",
      "schedule": "0 5,6 * * *"
    },
    {
      "path": "/api/compliance/hgv/sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/maintenance/alerts/digest",
      "schedule": "30 6 * * 1-5"
    },
    {
      "path": "/api/activity/retention",
      "schedule": "20 2 * * *"
    }
  ]
}
